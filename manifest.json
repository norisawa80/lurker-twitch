{
  "manifest_version": 3,
  "name": "Twitch Lurker Pro - Auto Points & Keep-Alive",
  "version": "1.0.16",
  "description": "Riscatta automaticamente i punti canale bonus di Twitch e simula attività naturale per prevenire l'esclusione del lurk.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Twitch Lurker Pro"
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch-lurker-pro@antigravity",
      "strict_min_version": "109.0"
    }
  },
  "host_permissions": [
    "*://*.twitch.tv/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["scripts/background.js"],
    "service_worker": "scripts/background.js"
  }
}
